rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // 1. PRODUTOS (Catálogo da Loja & Gestão do Painel)
    // -------------------------------------------------------------------------
    // - Leitura e Escrita liberadas para sincronização direta do painel e estoque da loja
    match /products/{productId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------------------
    // 2. CONFIGURAÇÕES DO SITE (Banners, Categorias, Avisos, Frete, InfinitePay)
    // -------------------------------------------------------------------------
    // - Leitura e Escrita liberadas para salvar alterações instantaneamente
    match /settings/{docId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------------------
    // 3. EVENTOS BELLCLAY (Feiras culturais, oficinas, encontros)
    // -------------------------------------------------------------------------
    // - Leitura e Escrita liberadas para criação e ordenação no painel
    match /events/{eventId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------------------
    // 4. PEDIDOS (Orders & Checkout)
    // -------------------------------------------------------------------------
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------------------
    // 5. CLIENTES & PERFIS (Dados de envio e contato salvos)
    // -------------------------------------------------------------------------
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------------------
    // 6. EVENTOS ANALÍTICOS (Métricas e Tráfego)
    // -------------------------------------------------------------------------
    match /analytics_events/{eventId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------------------
    // 7. TELAS DE ANÚNCIOS & CAMPANHAS (Landing Pages & Welcome Screens)
    // -------------------------------------------------------------------------
    match /campaigns/{campaignId} {
      allow read, write: if true;
    }

    // Bloqueio preventivo padrão para qualquer coleção não mapeada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
